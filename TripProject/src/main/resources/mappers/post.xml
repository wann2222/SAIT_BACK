        <resultMap id="postList" type="Post">
        <result column="no" property="no"/>
        <result column="mid" property="mid"/>
        <result column="name" property="name"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="date" property="date"/>        
    </resultMap> 
  
  <select id="search"
        parameterType="map"
        resultMap="postList">
  SELECT
    p.no,
    p.mid,
    m.name,
    p.title,
    p.content,
    p.date
  FROM Posts p
  JOIN members m
    ON m.id = p.mid

  <!-- word가 있을 때만 WHERE절 생성 -->
  <where>
    <if test="word != null and word != ''">
      <choose>
        <!-- 이름으로 검색 -->
        <when test="key == 'name'">
          and m.name LIKE CONCAT('%', #{word}, '%')
        </when>

        <!-- 제목으로 검색 -->
        <when test="key == 'title'">
          and p.title LIKE CONCAT('%', #{word}, '%')
        </when>

        <!-- 내용으로 검색 (기본) -->
        <otherwise>
          and p.content LIKE CONCAT('%', #{word}, '%')
        </otherwise>
      </choose>
    </if>
  </where>
</select>
  
