    <mapper namespace="com.ssafy.trip.model.dao.PostDao">
         <select id="getPost" resultType="Post">           
               SELECT p.*, m.name
			   FROM posts p
               JOIN members m ON p.mid = m.id
               WHERE p.no = #{no};
           </select>
           
           <insert id="regist">
               insert into posts(mid,title,content,date) values(#{mid},#{title},#{content},#{date})
           </insert>
           
           <update id="update">
               update posts set title=#{post.title}, content=#{post.content}, date = #{post.date} where no=#{no}
           </update>
           
           <delete id="delete">
               delete from posts where no=#{no}    
           </delete>
        

        
        
        <select id="getTotalCount"
        parameterType="map"
        resultType="int">
  select count(*)
  from posts
  <!-- word 값이 있을 때만 WHERE 블록을 생성 -->
  <where>
    <if test="word != null and word != ''">
      <choose>
        <!-- 이름 검색: member 테이블에서 name에 word 포함된 id -->
        <when test="key == 'name'">
          and mid in (
            select id
            from members
            where name like concat('%', #{word}, '%')
          )
        </when>
        <!-- 제목 검색 -->
        <when test="key == 'title'">
          and title like concat('%', #{word}, '%')
        </when>
        <!-- 내용 검색 (기본) -->
        <otherwise>
          and content like concat('%', #{word}, '%')
        </otherwise>
      </choose>
    </if>
  </where>
</select>
        
