<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="com.ssafy.trip.model.dao.PostCommentDao">
  
  <select id="searchAll">
  	SELECT *
  	FROM POST_COMMENTS
  </select>
  
  <insert id="regist">
  	INSERT 
  	INTO POST_COMMENTS(post_id, mid, content)
  	VALUES(#{post_id}, #{mid}, #{content})
  </insert>
  
  <select id="searchByPostId">
  	SELECT * 
  	FROM POST_COMMENTS
  	WHERE post_id = #{post_id}
  </select>
  
  <delete id="delete">
  	DELETE 
  	FROM POST_COMMENTS
  	WHERE cid = #{cid}
  </delete>
  </mapper>