<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.ssafy.trip.model.dao.QnaDao">
    <select id="searchAll" resultType="com.ssafy.trip.model.dto.Qna">
        SELECT * FROM qna ORDER BY no DESC
    </select>
    <insert id="regist" parameterType="com.ssafy.trip.model.dto.Qna">
        INSERT INTO qna (mid, title, content, date)
        VALUES (#{mid}, #{title}, #{content}, NOW())
    </insert>
    <select id="searchByNo" resultType="com.ssafy.trip.model.dto.Qna">
        SELECT * FROM qna WHERE no = #{no}
    </select>
    <update id="update" parameterType="com.ssafy.trip.model.dto.Qna">
        UPDATE qna SET
            title = #{title},
            content = #{content}
        WHERE no = #{no}
    </update>
    <delete id="delete" parameterType="int">
        DELETE FROM qna WHERE no = #{no}
    </delete>
</mapper>
